FLASK_ENV=production
CLINICAL_API_REQUIRE_AUTH=1
CLINICAL_API_ALLOWED_ORIGIN=https://seu-frontend.com

# Caminho absoluto para a service account do Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_FILE=C:/secrets/firebase-service-account.json

# Opcional: alternativa ao FIREBASE_SERVICE_ACCOUNT_FILE
# GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/firebase-service-account.json
